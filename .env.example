# oss-learn environment template
# Copy to .env and fill in values if needed.
# Most defaults work for local development.

# ── PostgreSQL ────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=osslearn
POSTGRES_PORT=5432

# ── Grafana ───────────────────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=oss-admin

# ── Ollama ────────────────────────────────────────────────────────────
OLLAMA_PORT=11434
# Default model pulled during setup (set to empty to skip model download)
OLLAMA_MODEL=llama3.2:1b

# ── OpenSearch (optional) ─────────────────────────────────────────────
OPENSEARCH_PORT=9200
OPENSEARCH_DASHBOARDS_PORT=5601
